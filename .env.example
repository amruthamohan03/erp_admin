DATABASE_URL=postgresql://postgres:postgres@localhost:5432/admin_dashboard
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=admin_dashboard

# Signs and verifies the session cookie. Leave this at the placeholder and the
# app falls back to a secret that is committed in this repo — anyone could then
# forge a session. Generate a real one per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it invalidates every issued token, so users have to log in again.
JWT_SECRET=change-this-to-a-random-32-char-secret-please-do-it
JWT_EXPIRES_IN=7d

# Whether the auth cookie carries the `secure` flag. Defaults to on when
# NODE_ENV=production. Set to false when a production build is served over
# plain HTTP (a staging box reached by IP) — the browser drops a secure cookie
# on http://, and login then silently redirects back to /login.
AUTH_COOKIE_SECURE=

NODE_ENV=development

# `next dev` blocks cross-origin requests for its dev resources (HMR). Set this
# when running the dev server on a remote box you reach by IP or hostname —
# comma-separated, no scheme. Not needed for localhost or for `next start`.
NEXT_ALLOWED_DEV_ORIGINS=

# Notification dispatcher — SMTP for the email channel.
# Leave SMTP_HOST blank to keep notifications going to the console
# (useful in dev; `npm run dispatch:notifications` still works).
SMTP_HOST=
SMTP_PORT=587
# Set to "true" to force TLS; auto-detected for port 465 otherwise.
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Required when SMTP_HOST is set — the From: address on every email.
SMTP_FROM=

# Translation provider behind /api/v1/translate (src/lib/translate.ts).
# Default is mymemory: free, no key, ~5k chars/day anonymously — set
# MYMEMORY_EMAIL to lift that to ~50k. Switch to libretranslate only with a
# LIBRETRANSLATE_URL you control; the public instance is unreliable.
TRANSLATE_PROVIDER=mymemory
MYMEMORY_EMAIL=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Integration tests. Set to a Postgres connection string to skip
# Testcontainers and use a pre-provisioned DB. Leave blank to have the
# vitest globalSetup spin up a postgres:16-alpine container via Docker.
# Required for CI environments without Docker access.
TEST_DATABASE_URL=
